#!/bin/sh

commit_msg_file="$1"
commit_message=$(head -n 1 "$commit_msg_file")

# Validate commit message format
# Format: Jira:<ticket-number> <description>
# The ticket number must be a positive integer, and there must be a description after it
if ! printf '%s\n' "$commit_message" | grep -Eq '^Jira:[0-9]+ .+$'; then
    echo ""
    echo "ERROR: Invalid commit message format."
    echo "Required format: Jira:<ticket-number> <description>"
    echo "Examples:"
    echo "  Jira:1234 Fix login validation"
    echo "  Jira:5678 Add API automation tests"
    echo ""
    echo "Your commit message: $commit_message"
    echo ""
    exit 1
fi

echo "Commit message validation passed."
exit 0
